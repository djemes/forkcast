    <!-- About -->
    <string name="about_version">Versão %1$s (%2$d)</string>
    <string name="about_privacy_title">Privacidade</string>
    <string name="about_privacy_body">O Forkcast não tem contas, análises, anúncios nem servidor próprio. Seu registro fica neste celular. Ele só se conecta a serviços que você mesmo configurou: bancos de alimentos (USDA, Open Food Facts) para buscas e seu serviço de IA para as fotos das refeições e suas descrições. Ele pergunta ao GitHub se existe um Forkcast mais novo: quando você procura atualizações e, no máximo uma vez por dia, se a verificação automática estiver ligada. Os backups vão só para onde você escolher salvá-los. Os dados do Health Connect (peso, atividade) ficam no celular e nunca são enviados aos serviços de IA.</string>
    <string name="about_medical_title">Não é orientação médica</string>
    <string name="about_medical_body">O Forkcast faz estimativas, principalmente a partir de fotos. Pese a comida quando a precisão importar, e converse com um médico ou nutricionista antes de grandes mudanças.</string>
    <string name="about_licenses_title">Licenças</string>
    <string name="about_app_license_title">Licença do Forkcast</string>
    <string name="about_app_license_body">O Forkcast é software livre e de código aberto: você pode usar, estudar, compartilhar e modificar o app nos termos da GNU General Public License, versão 3, com uma permissão adicional para as bibliotecas ML Kit e Play services do Google. Ele vem sem nenhuma garantia.</string>
    <string name="about_app_license_open">Ler a licença do Forkcast</string>
    <string name="about_libraries_title">Bibliotecas de código aberto</string>
    <string name="about_libraries_body">O Forkcast é feito com estas bibliotecas e com a fonte Manrope. Toque em uma para ler a licença.</string>
    <string name="about_report_title">Relatar um problema</string>
    <string name="about_report_body">Encontrou um erro ou algo que não faz sentido? Relate no GitHub. O suporte é feito na medida do possível, então a resposta pode demorar. Não inclua chaves de API nem dados pessoais: outras pessoas podem ler as issues.</string>
    <string name="about_report_open">Abrir o GitHub Issues</string>
    <string name="about_legal_title">Termos, privacidade e licenças</string>
    <string name="about_support_title">Apoie o Forkcast</string>
    <string name="about_support_body">O Forkcast é gratuito e de código aberto. Se ele te ajuda, você pode deixar uma gorjeta. Gorjetas são voluntárias e não liberam nada.</string>
    <string name="support_kofi">Apoie no Ko-fi</string>
    <string name="support_card_body">Grátis e sem anúncios. Gorjetas ajudam a manter assim.</string>
    <string name="support_card_hide">Ocultar o cartão do Ko-fi</string>
    <string name="support_card_hidden">Oculto. Você ainda pode apoiar o Forkcast em Configurações › Sobre.</string>
    <string name="support_coming_soon">Em breve</string>
    <string name="about_attributions_title">Créditos</string>
    <string name="about_attribution_off">Dados de alimentos do Open Food Facts (openfoodfacts.org), disponíveis sob a Open Database License (ODbL).</string>
    <string name="about_attribution_usda">Dados de alimentos do USDA FoodData Central (fdc.nal.usda.gov), Departamento de Agricultura dos EUA.</string>
    <string name="link_no_browser">Nenhum navegador neste celular consegue abrir o link.</string>
    <string name="about_not_affiliated">O Forkcast não é afiliado nem endossado por Google, Anthropic, OpenAI, USDA, Open Food Facts, Samsung ou Ko-fi. Os nomes de produtos pertencem aos seus donos.</string>

