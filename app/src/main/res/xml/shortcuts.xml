<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app icon (SPEC §3 Phase 5). Each logs to the meal that fits the time of day. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="scan"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_scan"
        android:shortcutShortLabel="@string/shortcut_scan"
        android:shortcutLongLabel="@string/shortcut_scan_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="app.forkcast"
            android:targetClass="app.forkcast.MainActivity">
            <extra android:name="app.forkcast.OPEN" android:value="scan" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="photo"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_photo"
        android:shortcutShortLabel="@string/shortcut_photo"
        android:shortcutLongLabel="@string/shortcut_photo_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="app.forkcast"
            android:targetClass="app.forkcast.MainActivity">
            <extra android:name="app.forkcast.OPEN" android:value="photo" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="search"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_search"
        android:shortcutShortLabel="@string/shortcut_search"
        android:shortcutLongLabel="@string/shortcut_search_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="app.forkcast"
            android:targetClass="app.forkcast.MainActivity">
            <extra android:name="app.forkcast.OPEN" android:value="search" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="water"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_water"
        android:shortcutShortLabel="@string/shortcut_water"
        android:shortcutLongLabel="@string/shortcut_water_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="app.forkcast"
            android:targetClass="app.forkcast.widget.AddWaterActivity" />
    </shortcut>
</shortcuts>
