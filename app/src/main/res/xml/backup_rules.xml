<!-- Android 10–11 backup rules (same exclusions as data_extraction_rules.xml). -->
<full-backup-content>
    <exclude domain="file" path="secrets/" />
    <exclude domain="file" path="photos/" />
    <exclude domain="sharedpref" path="secrets.xml" />
</full-backup-content>
