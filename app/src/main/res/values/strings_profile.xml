    <!-- Result -->
    <string name="onb_result_title">Your daily budget</string>
    <string name="budget_kcal_per_day">%1$s per day</string>
    <string name="macro_protein">Protein</string>
    <string name="macro_carbs">Carbs</string>
    <string name="macro_fat">Fat</string>
    <string name="macro_fiber">Fiber</string>
    <string name="how_calculated">How we calculated this</string>
    <string name="calc_bmr">Resting energy (Mifflin-St Jeor): 10 × %1$s kg + 6.25 × %2$s cm − 5 × %3$d (age) %4$s = %5$s</string>
    <string name="calc_bmr_male">+ 5</string>
    <string name="calc_bmr_female">− 161</string>
    <string name="calc_tdee">× %1$s for your activity = %2$s maintenance</string>
    <string name="calc_deficit">− %1$s a day to lose %2$s a week (about 7,700 kcal per kg of body weight, or 3,500 per lb)</string>
    <string name="calc_surplus">+ %1$s a day to gain %2$s a week (about 7,700 kcal per kg, or 3,500 per lb)</string>
    <string name="calc_maintain">No deficit or surplus: your budget is your maintenance.</string>
    <string name="calc_budget">Rounded to the nearest 10: %1$s</string>
    <string name="calc_macros">Protein 1.6 g per kg of current weight (capped at 2.2 g per kg of goal weight). Fat 30%% of calories. Carbs fill the rest. Fiber 14 g per 1,000 kcal.</string>
    <string name="calc_adaptive">Your log and weight trend over the last 4 weeks put your maintenance at %1$s (the formula said %2$s).</string>
    <string name="calc_adaptive_added_back">− %1$s a day, your average activity bonus (each day\'s bonus is added on that day) = %2$s</string>
    <string name="calc_activity_note">On top of this, %1$d %% of each day\'s active calories above your usual (up to %2$s) is added that day.</string>
    <string name="activity_bonus_setting">Add extra activity to my budget</string>
    <string name="activity_bonus_setting_on">%1$d %% of your active calories above a usual day, up to %2$s, is added to that day\'s budget.</string>
    <string name="activity_bonus_setting_off">Activity shows on Today but doesn\'t change your budget.</string>
    <string name="activity_advice" tools:ignore="PluralsCandidate">Your last %1$d days average %2$s active a day, which fits “%3$s”.</string>
    <string name="activity_advice_high">Your activity level is set higher than that. Activity above a usual day already adds budget, so a level that counts your workouts can count them twice.</string>
    <string name="activity_advice_low">Your activity level is set lower than that, so your budget may be on the low side.</string>
    <string name="calc_adaptive_note">These are formula estimates. After a few weeks of logging and weighing in, Forkcast can learn your real maintenance from your own data.</string>
    <string name="not_medical_advice">Forkcast gives estimates, not medical advice.</string>

