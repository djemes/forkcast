<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window theme before Compose draws; matches porcelain so there's no flash. -->
    <style name="Theme.Forkcast" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/porcelain</item>
    </style>

    <!-- SplashScreen API: porcelain background with the full adaptive icon (pine gradient + white fork).
         The white foreground alone is invisible on porcelain, and the icon-background attribute
         isn't applied to a 108dp adaptive-size foreground. -->
    <style name="Theme.Forkcast.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/porcelain</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.Forkcast</item>
    </style>
</resources>
