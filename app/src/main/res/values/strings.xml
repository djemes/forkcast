    <!-- About -->
    <string name="about_version">Version %1$s (%2$d)</string>
    <string name="about_privacy_title">Privacy</string>
    <string name="about_privacy_body">Forkcast has no accounts, no analytics, no ads, and no server of its own. Your log stays on this phone. It only talks to services you set up yourself: food databases (USDA, Open Food Facts) for searches, and your AI service for meal photos and their descriptions. It asks GitHub whether a newer Forkcast exists: when you check for updates, and at most once a day if automatic checks are on. Backups go only where you choose to save them. Health Connect data (weight, activity) stays on the phone and is never sent to AI services.</string>
    <string name="about_medical_title">Not medical advice</string>
    <string name="about_medical_body">Forkcast gives estimates, especially from photos. Weigh food when accuracy matters, and talk to a doctor or dietitian before big changes.</string>
    <string name="about_licenses_title">Licenses</string>
    <string name="about_app_license_title">Forkcast\'s license</string>
    <string name="about_app_license_body">Forkcast is free and open-source software: you can use, study, share and change it under the GNU General Public License, version 3, with an additional permission for Google\'s ML Kit and Play services libraries. It comes with no warranty.</string>
    <string name="about_app_license_open">Read Forkcast\'s license</string>
    <string name="about_libraries_title">Open-source libraries</string>
    <string name="about_libraries_body">Forkcast is built with these libraries and the Manrope font. Tap one to read its license.</string>
    <string name="about_support_title">Support Forkcast</string>
    <string name="about_support_body">Forkcast is free and open source. If it helps you, you can leave a tip. Tips are voluntary and don\'t unlock anything.</string>
    <string name="about_support_open">Leave a tip</string>
    <string name="about_attributions_title">Attributions</string>
    <string name="about_attribution_off">Food data from Open Food Facts (openfoodfacts.org), available under the Open Database License (ODbL).</string>
    <string name="about_attribution_usda">Food data from USDA FoodData Central (fdc.nal.usda.gov), U.S. Department of Agriculture.</string>
    <string name="about_not_affiliated">Forkcast is not affiliated with or endorsed by Google, Anthropic, OpenAI, the USDA, Open Food Facts, or Samsung. Product names belong to their owners.</string>

