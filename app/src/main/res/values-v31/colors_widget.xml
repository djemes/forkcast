<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Neutral tones from the phone's color palette, so the glass picks up the wallpaper's tint. -->
    <color name="widget_glass_light">@android:color/system_neutral1_50</color>
    <color name="widget_glass_dark">@android:color/system_neutral1_900</color>
    <!-- The launcher's own widget corner, so the glass rim follows One UI's shape. -->
    <dimen name="widget_radius">@android:dimen/system_app_widget_background_radius</dimen>
</resources>
