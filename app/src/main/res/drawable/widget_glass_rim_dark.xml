<?xml version="1.0" encoding="utf-8"?>
<!-- Glass sheen (dark): light falling on the top edge, fading out by the middle, and a thin bright rim. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient android:angle="270" android:startColor="#1FFFFFFF" android:centerColor="#00FFFFFF" android:endColor="#00FFFFFF" />
            <corners android:radius="@dimen/widget_radius" />
        </shape>
    </item>
    <item>
        <shape>
            <stroke android:width="1dp" android:color="#3DFFFFFF" />
            <corners android:radius="@dimen/widget_radius" />
        </shape>
    </item>
</layer-list>
