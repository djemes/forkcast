<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network is used only for services the user configured: USDA, Open Food Facts, their AI provider (and later Drive). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Barcode and nutrition-label scanning; asked for the first time the scanner opens. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <!-- Asked in context: the first time a notification is turned on or a photo is estimated (SPEC §4.8). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".ForkcastApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:localeConfig="@xml/locales_config"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Forkcast.Splash"
        tools:targetApi="37">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- No telemetry (CLAUDE.md non-negotiables): ML Kit queues usage logs for
             firebaselogging.googleapis.com through Google's datatransport. Without the backend
             discovery service no backend is registered, so queued batches are deleted unsent.
             Checked by ManifestPrivacyTest and on the emulator (DECISIONS.md 2026-10-19). -->
        <service
            android:name="com.google.android.datatransport.runtime.backends.TransportBackendDiscovery"
            tools:node="remove" />

        <!-- WorkManager is started by ForkcastApplication (Hilt worker factory), not by App Startup. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
