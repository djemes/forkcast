<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network is used only for services the user configured: USDA, Open Food Facts, their AI provider (and later Drive). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Barcode and nutrition-label scanning; asked for the first time the scanner opens. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Unlock prompt before a saved key is shown or copied (fingerprint, face or screen lock). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <!-- Asked in context: the first time a notification is turned on or a photo is estimated (SPEC §4.8). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- About › Check for updates: hands a release downloaded from GitHub to Android's installer,
         which asks the user to confirm (owner request 2026-10-20). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Android 12+: once Forkcast installed itself, a later update it starts needs no second prompt. -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <!-- Health Connect (SPEC §4.9), requested in Settings › Health Connect after a rationale.
         Must match HealthPermissions.ALL (ManifestPrivacyTest). -->
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="android.permission.health.READ_BODY_FAT" />
    <uses-permission android:name="android.permission.health.READ_HEIGHT" />
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_TOTAL_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.WRITE_NUTRITION" />
    <uses-permission android:name="android.permission.health.WRITE_HYDRATION" />
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_HISTORY" />
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND" />

    <!-- Android 13 and older: is the Health Connect app installed? -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application
        android:name=".ForkcastApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:localeConfig="@xml/locales_config"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Forkcast.Splash"
        tools:targetApi="37">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Long-press shortcuts: Scan, Photo meal, Search, +1 glass of water (Phase 5). -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>

        <!-- "+1 glass of water" shortcut: logs it and closes, never shown. -->
        <activity
            android:name=".widget.AddWaterActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Widget style: background opacity and color (on add and from the widget's menu). -->
        <activity
            android:name=".widget.WidgetSettingsActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Forkcast">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- PackageInstaller's answer for an update from About (AppInstaller). -->
        <receiver
            android:name=".update.InstallResultReceiver"
            android:exported="false" />

        <!-- Home-screen widget (Glance): Calories left, re-rendered after midnight. -->
        <receiver
            android:name=".widget.MidnightReceiver"
            android:exported="false" />
        <receiver
            android:name=".widget.CaloriesWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_calories_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_calories_info" />
        </receiver>

        <!-- Quick Settings tiles: barcode scan and AI photo meal. -->
        <service
            android:name=".widget.ScanTileService"
            android:exported="true"
            android:icon="@drawable/ic_barcode"
            android:label="@string/tile_scan"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".widget.PhotoTileService"
            android:exported="true"
            android:icon="@drawable/ic_photo_camera"
            android:label="@string/tile_photo"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Health Connect's privacy-policy link. Through Android 13: the rationale action. -->
        <activity
            android:name=".ui.health.HealthPrivacyActivity"
            android:exported="true"
            android:theme="@style/Theme.Forkcast">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- Android 14+: the same screen through the permission-usage alias (only the system may start it). -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".ui.health.HealthPrivacyActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- No telemetry (CLAUDE.md non-negotiables): ML Kit queues usage logs for
             firebaselogging.googleapis.com through Google's datatransport. Without the backend
             discovery service no backend is registered, so queued batches are deleted unsent.
             Checked by ManifestPrivacyTest and on the emulator (DECISIONS.md 2026-10-19). -->
        <service
            android:name="com.google.android.datatransport.runtime.backends.TransportBackendDiscovery"
            tools:node="remove" />

        <!-- WorkManager is started by ForkcastApplication (Hilt worker factory), not by App Startup. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
